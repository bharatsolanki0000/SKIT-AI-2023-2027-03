# CAMBER Backend Environment Variables

# Firebase Project Configuration
FIREBASE_PROJECT_ID=camber-ai-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@camber-ai-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Path to Firebase Service Account JSON file (Alternative to env vars)
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Server & CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
HOST=0.0.0.0
PORT=8000
